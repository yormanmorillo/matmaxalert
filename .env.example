# Copia este archivo a `.env` EN EL SERVIDOR (nunca lo subas al repo).
#   cp .env.example .env && chmod 600 .env
# Genera secretos con:
#   openssl rand -hex 32
#
# El compose usa estas variables para interpolar y las pasa al backend.
# MONGO_PASS debe ir también URL-encoded dentro de MONGODB_URI (usa hex para
# evitar caracteres especiales).

MONGO_USER=alertool
MONGO_PASS=REEMPLAZA_CON_32_BYTES_HEX
MONGODB_URI=mongodb://alertool:REEMPLAZA_CON_32_BYTES_HEX@mongodb:27017/alert_system?authSource=admin

# Firma de los JWT (rotarla invalida todas las sesiones)
JWT_SECRET=REEMPLAZA_CON_openssl_rand_hex_32

# Clave que nginx inyecta para autorizar escrituras de los kioskos
KIOSK_API_KEY=REEMPLAZA_CON_openssl_rand_hex_32

# Origen permitido para CORS (la IP/host real del servidor)
CORS_ORIGIN=http://192.0.2.10

# Solo se usa si la BD no tiene ningún admin (primer arranque)
ADMIN_INITIAL_PASSWORD=REEMPLAZA_CON_UNA_CONTRASEÑA_LARGA
ADMIN_USERNAME=admin

# false = no ejecutar el seed en cada arranque (recomendado tras el primer día)
SEED_ON_START=true

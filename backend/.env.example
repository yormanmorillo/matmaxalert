# Backend — desarrollo local
PORT=3000
NODE_ENV=development

# Mongo local (sin credenciales en el repo)
MONGODB_URI=mongodb://127.0.0.1:27017/alert_system

# Genera uno con: openssl rand -hex 32
JWT_SECRET=REEMPLAZA_CON_openssl_rand_hex_32

# En desarrollo, si se omite, las escrituras de kiosko no exigen clave.
KIOSK_API_KEY=REEMPLAZA_CON_openssl_rand_hex_32

CORS_ORIGIN=http://localhost:5173

# Solo se usa si la BD no tiene ningún admin
ADMIN_INITIAL_PASSWORD=REEMPLAZA_CON_UNA_CONTRASEÑA_LARGA
ADMIN_USERNAME=admin
SEED_ON_START=true

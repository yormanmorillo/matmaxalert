# El frontend se compila fuera de la imagen (`npm run build`) y aquí solo se
# empaqueta el resultado + nginx endurecido. `nginx.conf.template` se resuelve
# al arrancar con la variable KIOSK_API_KEY (envsubst del entrypoint oficial).
FROM nginx:1.27-alpine

COPY nginx/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
COPY dist /usr/share/nginx/html

RUN chmod -R a+rX /usr/share/nginx/html /etc/nginx/snippets /etc/nginx/templates

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1
